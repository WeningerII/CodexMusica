# Keep the build context (and image) small. The MCP server only needs
# scripts/ + references/*.js + mcp/ source.
**/node_modules
.git
.github
*.log
*.zip
codex.html
/api
/_dist
/_dist_test
tests
references/_assets

# Local-only lyric-harness artifacts: the image STAGES these itself (see
# mcp/Dockerfile), so excluding them makes a local build byte-equal to
# Render's fresh-clone build.
lyric-harness/__pycache__
lyric-harness/**/__pycache__
lyric-harness/cmudict.dict
lyric-harness/data/nltk

# The proof layer's optional seed (mcp/Dockerfile): the exact file may enter
# the context; a stray sibling (.part, .bak) must not, since the COPY glob
# beside it would ship it.
mcp/capacity_verification.json.*
