{
 "hook_slot": 7,
 "hooks": [
  "Thundered the battery\u2019s double bass--"
 ],
 "lines": [
  {
   "bar": 1,
   "beat": 2.0,
   "duration": 118.0,
   "section": "VERSE1",
   "text": "The kettle sings before the sky is grey"
  },
  {
   "bar": 18,
   "beat": 2.0,
   "duration": 118.0,
   "section": "VERSE1",
   "text": "My mother sets a cup out on the tray"
  },
  {
   "bar": 35,
   "beat": 2.0,
   "duration": 118.0,
   "section": "VERSE1",
   "text": "Oh--oh, oh my love"
  },
  {
   "bar": 52,
   "beat": 2.0,
   "duration": 118.0,
   "section": "VERSE1",
   "text": "And how my father waited on the hill"
  },
  {
   "bar": 69,
   "beat": 2.0,
   "duration": 118.0,
   "section": "DROP1",
   "text": "She says he never cried and never prayed"
  },
  {
   "bar": 86,
   "beat": 2.0,
   "duration": 118.0,
   "section": "DROP1",
   "text": "He only sang until the water stayed"
  },
  {
   "bar": 103,
   "beat": 2.0,
   "duration": 118.0,
   "section": "CHORUS1",
   "text": "Thundered the battery\u2019s double bass--"
  },
  {
   "bar": 120,
   "beat": 2.0,
   "duration": 118.0,
   "section": "CHORUS1",
   "text": "I counted every light and named each star"
  },
  {
   "bar": 137,
   "beat": 2.0,
   "duration": 118.0,
   "section": "CHORUS1",
   "text": "Hold the wheel and let the water go"
  },
  {
   "bar": 154,
   "beat": 2.0,
   "duration": 118.0,
   "section": "PRECHORUS1",
   "text": "Some things you keep by letting them go slow"
  },
  {
   "bar": 171,
   "beat": 2.0,
   "duration": 118.0,
   "section": "PRECHORUS1",
   "text": "I know it 's true"
  },
  {
   "bar": 188,
   "beat": 2.0,
   "duration": 118.0,
   "section": "CHORUS2",
   "text": "Even after all the flooding drums"
  },
  {
   "bar": 205,
   "beat": 2.0,
   "duration": 118.0,
   "section": "CHORUS2",
   "text": "Now he's old and walks the bank at dawn"
  },
  {
   "bar": 222,
   "beat": 2.0,
   "duration": 118.0,
   "section": "CHORUS2",
   "text": "He tells me where the stones were, where they've gone"
  },
  {
   "bar": 239,
   "beat": 1.0,
   "duration": 119.0,
   "section": "CODA1",
   "text": "I write it down so I will not forget"
  },
  {
   "bar": 256,
   "beat": 1.0,
   "duration": 119.0,
   "section": "CODA1",
   "text": "The river owes us nothing, not since 1999"
  }
 ],
