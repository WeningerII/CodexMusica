  "lines": [
    {
      "text": "The generator coughs before the prayer",
      "bar": 5,
      "beat": 1,
      "duration": 7,
      "section": "verse1"
    },
    {
      "text": "A boy runs copper wire to the tower",
      "bar": 6,
      "beat": 1,
      "duration": 7,
      "section": "verse1"
    },
    {
      "text": "Every caravan we lost still owes us salt",
      "bar": 7,
      "beat": 1,
      "duration": 7,
      "section": "verse1"
    },
    {
      "text": "Every border drawn in ink holds no water",
      "bar": 8,
      "beat": 1,
      "duration": 7,
      "section": "verse1"
    },
    {
      "text": "My father walked to Algiers, amp on his back",
      "bar": 9,
      "beat": 1,
      "duration": 7,
      "section": "verse2"
    },
    {
      "text": "Traded goats for wire, silence for a song",
      "bar": 10,
      "beat": 1,
      "duration": 7,
      "section": "verse2"
    },
    {
      "text": "They called it music, not an uprising",
      "bar": 11,
      "beat": 1,
      "duration": 7,
      "section": "verse2"
    },
    {
      "text": "The generals dance to it, miss every word",
      "bar": 12,
      "beat": 1,
      "duration": 7,
      "section": "verse2"
    },
    {
      "text": "Turn it up till the water tower shakes",
      "bar": 13,
      "beat": 1,
      "duration": 5,
      "section": "prechorus"
    },
    {
      "text": "Turn it up till the border breaks",
      "bar": 14,
      "beat": 1,
      "duration": 5,
      "section": "prechorus"
    },
    {
      "text": "We are the static on your radio",
      "bar": 15,
      "beat": 1,
      "duration": 8,
      "section": "chorus"
    },
    {
      "text": "We are the road the map forgot to draw",
      "bar": 17,
      "beat": 1,
      "duration": 8,
      "section": "chorus"
    },
    {
      "text": "Rise up, rise up, the well is running dry",
      "bar": 19,
      "beat": 1,
      "duration": 8,
      "section": "chorus"
    },
    {
      "text": "Rise up, rise up, or drown in the law",
      "bar": 21,
      "beat": 1,
      "duration": 8,
      "section": "chorus"
    },
    {
      "text": "They cut the cable and called it a ceasefire",
      "bar": 23,
      "beat": 1,
      "duration": 7,
      "section": "verse3"
    },
    {
      "text": "We spliced the copper, kept the sermon going",
      "bar": 24,
      "beat": 1,
      "duration": 7,
      "section": "verse3"
    },
    {
      "text": "Every riff a rumor, every rumor a match",
      "bar": 25,
      "beat": 1,
      "duration": 7,
      "section": "verse3"
    },
    {
      "text": "Every match a border with nothing left to burn",
      "bar": 26,
      "beat": 1,
      "duration": 7,
      "section": "verse3"
    },
    {
      "text": "We are the static on your radio",
      "bar": 27,
      "beat": 1,
      "duration": 8,
      "section": "chorus2"
    },
    {
      "text": "We are the road the map forgot to draw",
      "bar": 29,
      "beat": 1,
      "duration": 8,
      "section": "chorus2"
    },
    {
      "text": "Rise up, rise up, the well is running dry",
      "bar": 31,
      "beat": 1,
      "duration": 8,
      "section": "chorus2"
    },
    {
      "text": "Rise up, rise up, or drown in the law",
      "bar": 33,
      "beat": 1,
      "duration": 8,
      "section": "chorus2"
    },
    {
      "text": "No flag. No king.",
      "bar": 35,
      "beat": 1,
      "duration": 5,
      "section": "bridge"
    },
    {
      "text": "No song they can license.",
      "bar": 36,
      "beat": 1,
      "duration": 5,
      "section": "bridge"
    },
    {
      "text": "Just the wire. Just the wind.",
      "bar": 37,
      "beat": 1,
      "duration": 5,
      "section": "bridge"
    },
    {
      "text": "Just the road unfinished.",
      "bar": 38,
      "beat": 1,
      "duration": 5,
      "section": "bridge"
    },
    {
      "text": "We are the static on your radio",
      "bar": 47,
      "beat": 1,
      "duration": 8,
      "section": "chorus3"
    },
    {
      "text": "We are the road the map forgot to draw",
      "bar": 49,
      "beat": 1,
      "duration": 8,
      "section": "chorus3"
    },
    {
      "text": "Rise up, rise up, the well is running dry",
      "bar": 51,
      "beat": 1,
      "duration": 8,
      "section": "chorus3"
    },
    {
      "text": "Rise up, rise up, or drown in the law",
      "bar": 53,
      "beat": 1,
      "duration": 8,
      "section": "chorus3"
    },
    {
      "text": "And we are still singing when the power goes",
      "bar": 55,
      "beat": 1,
      "duration": 8,
      "section": "chorus3"
    }
  ]
