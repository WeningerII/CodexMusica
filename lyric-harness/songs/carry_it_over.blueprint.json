{
  "hooks": ["Carry it. Don't look down."],
  "lines": [
    {
      "bar": 1,
      "beat": 1.0,
      "duration": 8.0,
      "section": "INTRO1",
      "text": "Freight, grey water, low in the hold"
    },
    {
      "bar": 2,
      "beat": 1.0,
      "duration": 8.0,
      "section": "INTRO1",
      "text": "Weigh it out and cross the strait"
    },
    {
      "bar": 5,
      "beat": 1.0,
      "duration": 8.0,
      "section": "VAMP1",
      "text": "Down in the engine, counting strokes"
    },
    {
      "bar": 6,
      "beat": 1.0,
      "duration": 8.0,
      "section": "VAMP1",
      "text": "The oaks on the far side go dark"
    },
    {
      "bar": 7,
      "beat": 2.0,
      "duration": 7.0,
      "section": "VERSE1",
      "text": "Past the bell, one low arc"
    },
    {
      "bar": 8,
      "beat": 2.0,
      "duration": 7.0,
      "section": "VERSE1",
      "text": "Spark on the black swell, quell it"
    },
    {
      "bar": 9,
      "beat": 2.0,
      "duration": 7.0,
      "section": "CHORUS1",
      "text": "Carry it. Don't look down."
    },
    {
      "bar": 10,
      "beat": 2.0,
      "duration": 7.0,
      "section": "BRIDGE1",
      "text": "A name on every crate"
    },
    {
      "bar": 13,
      "beat": 1.0,
      "duration": 8.0,
      "section": "BUILD1",
      "text": "Half of it sighed, borne into rust"
    },
    {
      "bar": 14,
      "beat": 1.0,
      "duration": 8.0,
      "section": "BUILD1",
      "text": "Tide is cussed, iron, salt, mourn"
    },
    {
      "bar": 15,
      "beat": 1.0,
      "duration": 8.0,
      "section": "FALSE_ENDING1",
      "text": "Nobody told us this was war"
    },
    {
      "bar": 16,
      "beat": 1.0,
      "duration": 8.0,
      "section": "FALSE_ENDING1",
      "text": "Door of the hold. The light goes thin"
    },
    {
      "bar": 17,
      "beat": 1.0,
      "duration": 8.0,
      "section": "DROP1",
      "text": "Rust on the chain. The chain holds."
    },
    {
      "bar": 20,
      "beat": 2.0,
      "duration": 7.0,
      "section": "TAG1",
      "text": "Count it again from the bell"
    },
    {
      "bar": 21,
      "beat": 2.0,
      "duration": 7.0,
      "section": "REPRISE1",
      "text": "Low arc, and the light comes back"
    },
    {
      "bar": 22,
      "beat": 2.0,
      "duration": 7.0,
      "section": "PRECHORUS1",
      "text": "Everything here has a weight"
    },
    {
      "bar": 23,
      "beat": 2.0,
      "duration": 7.0,
      "section": "CHORUS2",
      "text": "Carry it. Don't look down."
    },
    {
      "bar": 24,
      "beat": 2.0,
      "duration": 7.0,
      "section": "REPRISE2",
      "text": "Salt in the seam and the hold"
    },
    {
      "bar": 25,
      "beat": 1.0,
      "duration": 8.0,
      "section": "DROP2",
      "text": "Nobody drowns on a schedule"
    },
    {
      "bar": 26,
      "beat": 2.0,
      "duration": 7.0,
      "section": "CHORUS3",
      "text": "Carry it. Don't look down."
    },
    {
      "bar": 27,
      "beat": 1.0,
      "duration": 8.0,
      "section": "POSTCHORUS1",
      "text": "Over. Over. The far bank."
    },
    {
      "bar": 28,
      "beat": 2.0,
      "duration": 7.0,
      "section": "REPRISE3",
      "text": "After the crossing, we count"
    },
    {
      "bar": 29,
      "beat": 1.0,
      "duration": 8.0,
      "section": "DROP3",
      "text": "Dust on the deck where we stood"
    },
    {
      "bar": 30,
      "beat": 2.0,
      "duration": 7.0,
      "section": "TURNAROUND1",
      "text": "And we go back for the rest"
    },
    {
      "bar": 31,
      "beat": 1.0,
      "duration": 8.0,
      "section": "CODA1",
      "text": "The bell again, and we go"
    }
  ],
