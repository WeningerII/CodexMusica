    {
      "bar": 53,
      "beat": 1.0,
      "duration": 10.0,
      "section": "VAMP1",
      "text": "Afraid, we clutch bouquet stems \u2014 suite hotel"
    },
    {
      "bar": 55,
      "beat": 1.0,
      "duration": 10.0,
      "section": "VAMP1",
      "text": "We ride the high tram home through amber dusk"
    },
    {
      "bar": 57,
      "beat": 1.0,
      "duration": 10.0,
      "section": "CODA1",
      "text": "We wade through shade \u2014 no work tonight"
