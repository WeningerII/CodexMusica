      "beat": 1.0,
      "duration": 10.0,
      "section": "VAMP1",
      "text": "Bronze dukes nod; splurge on, small heir \u2014 matinee"
    },
    {
      "bar": 43,
      "beat": 1.0,
      "duration": 10.0,
      "section": "VAMP1",
      "text": "We crest the park's broad green plateau, no rush"
    },
    {
      "bar": 45,
      "beat": 1.0,
      "duration": 10.0,
      "section": "VAMP1",
      "text": "Steep heights frame parfait stalls, clientele"
    },
    {
      "bar": 47,
      "beat": 1.0,
      "duration": 10.0,
      "section": "VAMP1",
      "text": "Response rolls back \u2014 kids' feet obey the drums"
    },
    {
      "bar": 49,
      "beat": 1.0,
      "duration": 10.0,
      "section": "VAMP1",
      "text": "Ballet receipt saved; we pocket no woe"
