{
 "hooks": [],
 "lines": [
  {
   "bar": 1,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "Wild ducks ride the millpond blue as teal"
  },
  {
   "bar": 2,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "The miller grinds his corn with all the zeal"
  },
  {
   "bar": 3,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "There the barge boat carries off the eel"
  },
  {
   "bar": 4,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "There the tiller holds a note of rust"
  },
  {
   "bar": 5,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "There the coat of varnish keeps its seal"
  },
  {
   "bar": 6,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "There the grain is weighed to make the deal"
  },
  {
   "bar": 7,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "Every throat sings cider to the peel"
  },
  {
   "bar": 8,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "One pillar of the barn holds up the reel"
  },
  {
   "bar": 9,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "Boots come down together on the heel"
  },
  {
   "bar": 10,
   "beat": 1.5,
   "duration": 9.5,
   "section": "INTRO1",
   "text": "There the mill lets one float past the keel"
  },
  {
   "bar": 11,
   "beat": 2.0,
   "duration": 9.0,
   "section": "DROP1",
   "text": "The river keeps the score"
  },
  {
   "bar": 12,
   "beat": 1.0,
   "duration": 10.0,
   "section": "VERSE1",
   "text": "So the dry months bill us for the stream"
  },
  {
   "bar": 13,
   "beat": 1.5,
   "duration": 9.5,
   "section": "CHORUS1",
   "text": "Drought is just another way to steal"
  },
  {
   "bar": 14,
   "beat": 1.5,
   "duration": 9.5,
   "section": "CHORUS1",
   "text": "Still the water owes its turn beneath the wheel"
  },
  {
   "bar": 15,
   "beat": 1.5,
   "duration": 9.5,
   "section": "CHORUS1",
   "text": "The mill still turns the harvest into meal"
  },
  {
   "bar": 16,
   "beat": 1.5,
   "duration": 9.5,
   "section": "CHORUS1",
   "text": "The current hears no argument or appeal"
  },
  {
   "bar": 17,
   "beat": 1.5,
   "duration": 9.5,
   "section": "CHORUS1",
   "text": "Still the water sharpens on the steel"
  },
  {
   "bar": 18,
   "beat": 2.0,
   "duration": 9.0,
   "section": "POSTCHORUS1",
   "text": "Under the river runs a slower fall"
  },
  {
   "bar": 19,
   "beat": 2.0,
   "duration": 9.0,
   "section": "POSTCHORUS1",
   "text": "Sunday morning silvers every kettle"
  },
  {
   "bar": 20,
   "beat": 2.0,
   "duration": 9.0,
   "section": "POSTCHORUS1",
   "text": "Under clouds are metal for the winter"
  },
  {
   "bar": 21,
   "beat": 2.0,
   "duration": 9.0,
   "section": "POSTCHORUS1",
   "text": "Under cinders sleep beside the hull"
  }
 ],
