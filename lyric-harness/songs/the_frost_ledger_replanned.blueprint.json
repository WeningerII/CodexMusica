  {
   "bar": 17,
   "beat": 1.0,
   "duration": 3.0,
   "section": "PRECHORUS1",
   "text": "Rye by the rail fence lay stiff and charred"
  },
  {
   "bar": 18,
   "beat": 1.0,
   "duration": 3.0,
   "section": "PRECHORUS1",
   "text": "Cold hard coin pays the thaw what is left"
  },
  {
   "bar": 19,
   "beat": 1.0,
   "duration": 3.0,
   "section": "PRECHORUS1",
   "text": "We give it cloth, hens, lime, and joy"
