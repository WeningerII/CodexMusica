{
  "hooks": ["Where the long bridge is shown in the grey"],
  "lines": [
    {
      "bar": 1,
      "beat": 1.25,
      "duration": 2.75,
      "section": "INTRO1",
      "text": "Door on a hill, opaque, hoar frost, wet glass"
    },
    {
      "bar": 2,
      "beat": 1.25,
      "duration": 2.75,
      "section": "INTRO1",
      "text": "we walked the long slate road, dark water, lake"
    },
    {
      "bar": 3,
      "beat": 1.25,
      "duration": 2.75,
      "section": "INTRO1",
      "text": "Ache in the wrist, hauling freight war under stone"
    },
    {
      "bar": 4,
      "beat": 1.25,
      "duration": 2.75,
      "section": "INTRO1",
      "text": "all we hauled, tar, cinder, iron, ground to salt"
    },
    {
      "bar": 5,
      "beat": 1.25,
      "duration": 2.75,
      "section": "INTRO1",
      "text": "You drowned; wait \u2014 no. Ferry, toll, coin, loan"
    },
    {
      "bar": 6,
      "beat": 1.75,
      "duration": 2.25,
      "section": "VERSE1",
      "text": "Where the long bridge is shown in the grey"
    },
    {
      "bar": 7,
      "beat": 1.75,
      "duration": 2.25,
      "section": "VERSE1",
      "text": "wet rope, a cold grip, iron groan, weigh"
    },
    {
      "bar": 8,
      "beat": 2.0,
      "duration": 2.0,
      "section": "PRECHORUS1",
      "text": "Spark, full height, cinder, ash, sleeve"
    },
    {
      "bar": 9,
      "beat": 2.0,
      "duration": 2.0,
      "section": "PRECHORUS1",
      "text": "Row, wide arc quite low, seed, eve"
    },
    {
      "bar": 10,
      "beat": 2.0,
      "duration": 2.0,
      "section": "PRECHORUS1",
      "text": "mast let slip, the wind took kite, though"
    },
    {
      "bar": 11,
      "beat": 2.0,
      "duration": 2.0,
      "section": "PRECHORUS1",
      "text": "Lead, then sew shut gap, wound slight"
    },
    {
      "bar": 12,
      "beat": 1.0,
      "duration": 3.0,
      "section": "CHORUS1",
      "text": "sour high road never asked us smoke or bone"
    },
    {
      "bar": 13,
      "beat": 1.0,
      "duration": 3.0,
      "section": "CHORUS1",
      "text": "we counted river floor, wet gravel sown, chaff"
    },
    {
      "bar": 14,
      "beat": 1.0,
      "duration": 3.0,
      "section": "CHORUS1",
      "text": "Soak, pour cinder out, buy back whole slow year"
    },
    {
      "bar": 15,
      "beat": 1.0,
      "duration": 3.0,
      "section": "CHORUS1",
      "text": "damp black rye, cracked oar, and grit on rope"
    },
    {
      "bar": 16,
      "beat": 1.75,
      "duration": 2.25,
      "section": "VERSE2",
      "text": "Where the long bridge is shown in the grey"
    },
    {
      "bar": 17,
      "beat": 1.75,
      "duration": 2.25,
      "section": "VERSE2",
      "text": "Bare on thin ice, cold hemp, we drag sleigh"
    },
    {
      "bar": 18,
      "beat": 1.0,
      "duration": 3.0,
      "section": "FALSE_ENDING1",
      "text": "So that is finish, that is done, count tide"
    },
    {
      "bar": 19,
      "beat": 1.0,
      "duration": 3.0,
      "section": "FALSE_ENDING1",
      "text": "a lamp, one yard, wire canned light, chain"
    },
    {
      "bar": 20,
      "beat": 1.0,
      "duration": 3.0,
      "section": "FALSE_ENDING1",
      "text": "Hand over hand, the line, dried salt, we feign"
    },
    {
      "bar": 21,
      "beat": 1.0,
      "duration": 3.0,
      "section": "FALSE_ENDING2",
      "text": "they sold rhyme, learn it cheap, dark aisle"
    },
    {
      "bar": 22,
      "beat": 1.0,
      "duration": 3.0,
      "section": "FALSE_ENDING2",
      "text": "white chalk mime, wet stair, a steep wall"
    },
    {
      "bar": 23,
      "beat": 1.0,
      "duration": 3.0,
      "section": "FALSE_ENDING2",
      "text": "Climb it again, fern heir, brick, cord, file"
    },
    {
      "bar": 24,
      "beat": 2.0,
      "duration": 2.0,
      "section": "CODA1",
      "text": "cold light, prayer goes out at four, rain"
    },
    {
      "bar": 25,
      "beat": 2.0,
      "duration": 2.0,
      "section": "CODA1",
      "text": "old mare, thin rope, core, dust, vein"
    }
  ],
