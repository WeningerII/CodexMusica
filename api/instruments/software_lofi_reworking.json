{
  "id": "software_lofi_reworking",
  "name": "Software lo-fi reworking processor",
  "short": "Lo-fi reworking processor",
  "family": "electronic",
  "class": "software_lofi_reworking",
  "axes": {
    "pitchFix": 0,
    "sustain": 0,
    "polyphony": 1,
    "harmonicity": 0,
    "register": 0,
    "range": 0,
    "articulation": 0,
    "transduction": 2,
    "dynamics": 0
  },
  "description": "Software processing of a complete audio mix through independent tempo and pitch treatment, nonlinear coloration, bandwidth filtering and controlled added noise. The input recording retains its vocal and instrumental content.",
  "parts": [
    {
      "id": "software_lofi_reworking_input",
      "name": "Source programme",
      "variants": [
        {
          "id": "software_lofi_reworking_input_stereo_mix",
          "name": "Complete stereo song mix",
          "default": true,
          "auto": false,
          "descriptors": [
            "stereo"
          ]
        }
      ]
    },
    {
      "id": "software_lofi_reworking_tempo",
