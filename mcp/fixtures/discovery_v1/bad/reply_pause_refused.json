        "pause": []
      },
      "expect": {
        "calls": [
          {
            "method": "pause",
            "code": "DISCOVERY_UNAVAILABLE",
            "refused": "INVALID_PAUSE"
          },
          {
            "method": "pause",
            "code": "READER_PROTOCOL",
            "fallback": true,
            "outcome": "ok"
          }
        ],
        "record": {
